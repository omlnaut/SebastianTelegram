# Environment for sebastian-telegram.service.
#
# Installed as /etc/sebastian-telegram/env (see deploy/README.md). This file is
# not secret and must never contain the bot token: the token lives in its own
# 0600 file named by SEBASTIAN_TELEGRAM_TOKEN_FILE.
#
# Replace the allowlist placeholder with your own chat ID. "0" is a valid chat
# ID that matches no chat, so a freshly installed bridge answers nobody.
SEBASTIAN_TELEGRAM_ALLOWLIST=0
SEBASTIAN_TELEGRAM_TOKEN_FILE=/home/pi/.config/sebastian-telegram/token
SEBASTIAN_TELEGRAM_STATE_DIR=/home/pi/.local/state/sebastian-telegram
SEBASTIAN_TELEGRAM_VAULT_DIR=/home/pi/vault
SEBASTIAN_TELEGRAM_PI_BIN=/home/pi/.local/bin/pi
# SEBASTIAN_TELEGRAM_POLL_TIMEOUT=30
# SEBASTIAN_TELEGRAM_API_BASE_URL=https://api.telegram.org
